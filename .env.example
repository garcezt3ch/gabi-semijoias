# Shopify Storefront API — catálogo, imagens, carrinho e checkout
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-token

# Manus OAuth e sessão administrativa
MANUS_PROJECT_ID=replace-with-project-id
MANUS_JWT_SECRET=replace-with-session-secret
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_API_URL=https://api.manus.ai
MANUS_API_KEY=replace-with-server-key
MANUS_API_BROWSER_KEY=replace-with-browser-key
OWNER_OPEN_ID=replace-with-owner-open-id

# MySQL/Drizzle — necessário para login e painel administrativo
DATABASE_URL=mysql://user:password@host:3306/database
